{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Observability": {
    "_comment_ServiceName": "traceId/spanId/service/level are the mandatory fields on every log entry (observability-standards.md); ServiceName is the 'service' field.",
    "ServiceName": "kart-category-service",
    "Otlp": {
      "_comment_Endpoint": "OpenTelemetry Collector OTLP/gRPC endpoint. Services never ship traces/logs to Tempo/Loki directly (observability-standards.md).",
      "Endpoint": "http://localhost:4317"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CategoryDatabase": "Host=localhost;Port=5432;Database=kart_category;Username=kart_category_service;Password=changeme",
    "Redis": "localhost:6379"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Exchange": "category.exchange"
  },
  "Identity": {
    "JwksUri": "http://kart-identity-service/.well-known/jwks.json"
  }
}
